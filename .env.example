FIREBASE_PROJECT_ID=zamon-c4a03
FIREBASE_STORAGE_BUCKET=zamon-c4a03.firebasestorage.app
# Local only: downloaded service account JSON file, never commit it.
FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json
# Netlify only: set this to the entire service account JSON in environment variables.
FIREBASE_SERVICE_ACCOUNT_JSON=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://essential-mastery.netlify.app

# Private shared teacher registration code; minimum 12 characters.
TEACHER_ACCESS_CODE=

# Separate private Administrator registration code; minimum 12 characters.
ADMINISTRATOR_ACCESS_CODE=

# Owner direct access, shared across every centre; maximum 3 active browser devices.
# Minimum 12 characters. Choose your own code or generate
# using node scripts/setup-owner.mjs. Keep secret and distinct from staff codes.
OWNER_ACCESS_CODE=

# Separate shared advertiser registration code: exactly 12 characters.
ADVERTISER_ACCESS_CODE=
# Optional: custom voice created with adult speaker's reference + consent in AI Studio.
# Bind it to the exact Firebase user ID, never just a display name.
ODINA_VOICE_USER_ID=
ODINA_VOICE_ID=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
